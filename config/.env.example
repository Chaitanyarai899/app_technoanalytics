# =============================================================================
# MODERN RASTER ARCHITECTURE - Environment Configuration
# Copy this file to .env and update with your values
# =============================================================================

# =============================================================================
# Google Cloud Platform Configuration
# =============================================================================

# Your GCP Project ID
PROJECT_ID=your-project-id

# GCS Bucket name (must be globally unique)
GCS_BUCKET=your-unique-bucket-name

# Your domain name for the TiTiler service
DOMAIN_NAME=tiles.yourdomain.com

# GCP Region (choose nearest to your users)
REGION=us-central1

# =============================================================================
# Supabase Configuration  
# =============================================================================

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase service role key (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database configuration
SUPABASE_SCHEMA=public
SUPABASE_TABLE=productos

# =============================================================================
# TiTiler Configuration
# =============================================================================

# TiTiler Docker image version
TITILER_IMAGE=ghcr.io/developmentseed/titiler:latest

# Cloud Run service name
TITILER_SERVICE_NAME=titiler-service

# Memory limit for TiTiler service (adjust based on your raster sizes)
TITILER_MEMORY=2Gi

# CPU limit for TiTiler service  
TITILER_CPU=1000m

# Maximum concurrent requests per instance
TITILER_CONCURRENCY=80

# Scaling configuration
TITILER_MAX_INSTANCES=10
TITILER_MIN_INSTANCES=0

# =============================================================================
# CDN Configuration
# =============================================================================

# Cache TTL for tiles (in seconds) - 1 hour default
CACHE_TTL=3600

# Cache TTL for static assets (in seconds) - 1 day default  
STATIC_CACHE_TTL=86400

# Enable Cloud CDN
USE_CLOUD_CDN=true

# =============================================================================
# COG Processing Configuration
# =============================================================================

# GDAL creation options for COG conversion
COG_COMPRESS=LZW
COG_PREDICTOR=2
COG_BIGTIFF=AUTO
COG_OVERVIEW_RESAMPLING=BILINEAR

# Default EPSG code for raster data
DEFAULT_EPSG=4326

# Tiling configuration
COG_BLOCKSIZE=512

# =============================================================================
# Flutter App Configuration
# =============================================================================

# Enable modern tiles in Flutter app (true/false)
USE_MODERN_TILES=true

# Tile size for map rendering
TILE_SIZE=256

# Maximum zoom level
MAX_ZOOM=18

# TiTiler base URL for Flutter
TITILER_BASE_URL=https://tiles.yourdomain.com

# =============================================================================
# Development Configuration
# =============================================================================

# Enable debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose logging for debugging
VERBOSE=false

# Monitoring
ENABLE_MONITORING=true
ALERT_EMAIL=alerts@yourdomain.com
